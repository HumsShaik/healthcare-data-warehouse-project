      <aliases enabled='yes' />
      <column caption='Cost Status' datatype='string' name='[Calculation_1654791398952005632]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([cost]) &gt; 8000000 THEN&#13;&#10;    &quot;Excellent&quot;&#13;&#10;ELSEIF SUM([cost]) &gt; 5000000 THEN&#13;&#10;    &quot;Good&quot;&#13;&#10;ELSE&#13;&#10;    &quot;Needs Attention&quot;&#13;&#10;END' />
      </column>
      <column caption='Satisfaction KPI Color' datatype='string' name='[Calculation_1654791398953242625]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF AVG([satisfaction]) &gt;= 4 THEN&#13;&#10;    &quot;High Satisfaction&quot;&#13;&#10;ELSEIF AVG([satisfaction]) &gt;= 3 THEN&#13;&#10;    &quot;Medium Satisfaction&quot;&#13;&#10;ELSE&#13;&#10;    &quot;Low Satisfaction&quot;&#13;&#10;END' />
      </column>
      <column caption='Readmission Color' datatype='string' name='[Calculation_1654791398953893890]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [readmission_status] = &quot;Yes&quot; THEN&#13;&#10;    &quot;Readmitted&quot;&#13;&#10;ELSE&#13;&#10;    &quot;Not Readmitted&quot;&#13;&#10;END' />
      </column>
